{
  "manifest_version": 3,
  "name": "Кадр — темы для kinoarc",
  "short_name": "Кадр",
  "version": "1.3.0",
  "description": "Родные цветовые темы kinoarc и свой аватар — на компьютере и на телефоне. Меняет только оформление у тебя в браузере.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["*://kinoarc.net/*", "*://*.kinoarc.net/*"],
  "content_scripts": [
    {
      "matches": ["*://kinoarc.net/*", "*://*.kinoarc.net/*"],
      "js": ["themes.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Кадр — тема и аватар",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": ["popup.html"],
      "matches": ["*://kinoarc.net/*", "*://*.kinoarc.net/*"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "kadr-themes@kinoarc",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    },
    "gecko_android": {
      "strict_min_version": "128.0"
    }
  }
}
