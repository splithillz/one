{
  "manifest_version": 3,
  "name": "Кадр — темы для kinoarc",
  "version": "1.2.0",
  "description": "Родные цветовые темы kinoarc и свой аватар у тебя в браузере. Меняет только оформление.",
  "permissions": ["storage"],
  "host_permissions": ["*://kinoarc.net/*", "*://*.kinoarc.net/*"],
  "content_scripts": [
    {
      "matches": ["*://kinoarc.net/*", "*://*.kinoarc.net/*"],
      "js": ["themes.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Кадр — темы"
  }
}
