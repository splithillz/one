{
  "manifest_version": 3,
  "name": "Кадр — темы для kinohub",
  "short_name": "Кадр kinohub",
  "version": "1.2.1",
  "description": "Темы, новый дизайн, закладки под рукой и тайминги у плеера для on.kinohub.vip — на компьютере и на телефоне.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://on.kinohub.vip/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://on.kinohub.vip/*"
      ],
      "js": [
        "themes.js",
        "kit.js",
        "content.js",
        "lists.js",
        "timings.js",
        "cast.js"
      ],
      "run_at": "document_start",
      "css": [
        "skin.css",
        "ui.css"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Кадр — темы для kinohub",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "fonts/onest-cyrillic.woff2",
        "fonts/onest-latin.woff2"
      ],
      "matches": [
        "*://on.kinohub.vip/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "kadr-themes@kinohub",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "128.0"
    }
  }
}
